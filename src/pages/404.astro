---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Page Not Found | Martens Driving School';
const description = 'The page you\'re looking for couldn\'t be found. Return to Martens Driving School in Steinbach for driving lessons and road test prep.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main class="site-main">
			<section class="section-container" style="padding: 4rem 1.5rem 2rem; display: flex; justify-content: center;">
				<div class="sanctuary-card" style="padding: 3.5rem 2.5rem; max-width: 640px; width: 100%; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.25rem;">
					<div class="eyebrow-badge eyebrow-badge--light">
						<span class="badge-dot"></span>
						<span>404 Error</span>
					</div>
					<h1 style="color: var(--text-primary-light); font-size: clamp(2rem, 3vw + 1rem, 2.75rem); margin: 0;">Page Not Found</h1>
					<p style="color: var(--text-secondary-light); font-size: 1.1rem; line-height: 1.6; margin: 0; max-width: 48ch;">
						Sorry, we couldn't find the page you're looking for. Head back to Martens Driving School in Steinbach to view lesson pricing or book with Carlos or Noemi.
					</p>
					<div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 1rem;">
						<a class="btn btn-primary" href="/">Back to Home</a>
						<a class="btn btn-navy" href="/#services">View Driving Lessons</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
