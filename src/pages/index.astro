			<!-- Script Handling: Form Validation, Analytics, and Modal (Preserved 100%) -->
			<script>
				// If form was just submitted, show a dismissible modal to prevent double-submits
				const params = new URLSearchParams(window.location.search);
				const submissionModal = document.getElementById('submission-modal');
				const dismissModalBtn = document.getElementById('submission-modal-dismiss');
				if (params.has('sent') && params.get('sent') === '1' && submissionModal) {
					submissionModal.hidden = false;
					document.body.style.overflow = 'hidden';
					// Keep the submit button disabled so users cannot re-send
					const formSubmitBtn = document.querySelector('.contact-form button[type="submit"]');
					if (formSubmitBtn) {
						formSubmitBtn.disabled = true;
						formSubmitBtn.textContent = 'Sent';
					}
					// focus the dismiss button for accessibility
					dismissModalBtn?.focus();
					// Remove the query param from URL without reloading
					window.history.replaceState({}, document.title, window.location.pathname + '#contact');
				}

				const contactForm = document.querySelector('.contact-form');
				if (contactForm) {
					const emailField = document.getElementById('cf-email');
					const phoneField = document.getElementById('cf-phone');
					const winnipegField = document.getElementById('cf-winnipeg');
					const nextField = document.getElementById('cf-next');
					const submitButton = contactForm.querySelector('button[type="submit"]');
					const statusEl = contactForm.querySelector('.form-status');

					if (nextField) {
						nextField.value = `${window.location.origin}${window.location.pathname}?sent=1#contact`;
					}

					contactForm.addEventListener('submit', function(e) {
						const email = document.getElementById('cf-email').value.trim();
						const phone = document.getElementById('cf-phone').value.trim();

						if (statusEl) {
							statusEl.textContent = '';
							statusEl.classList.remove('is-error', 'is-success');
						}

						if (!email && !phone) {
							e.preventDefault();
							if (statusEl) {
								statusEl.textContent = 'Please provide either an email address or phone number.';
								statusEl.classList.add('is-error');
							}
							emailField?.focus();
							return;
						}
						const winnipegDate = new Date().toLocaleString('en-CA', { timeZone: 'America/Winnipeg', hour12: false });
						if (winnipegField) {
							winnipegField.value = winnipegDate;
						}
						if (typeof window.gtag === 'function') {
							window.gtag('event', 'generate_lead', { method: 'form_submit' });
						}

						if (submitButton) {
							submitButton.disabled = true;
							submitButton.textContent = 'Sending...';
						}
						// Allow the form to submit naturally to FormSubmit
					});
				}

				document.querySelectorAll('a[href^="mailto:"]').forEach((el) => {
					el.addEventListener('click', () => {
						if (typeof window.gtag === 'function') {
							window.gtag('event', 'contact', { method: 'email_click' });
						}
					});
				});

				document.querySelectorAll('a[href^="sms:"]').forEach((el) => {
					el.addEventListener('click', () => {
						if (typeof window.gtag === 'function') {
							window.gtag('event', 'contact', { method: 'sms_click' });
						}
					});
				});

				const mapFrame = document.querySelector('.service-area-module iframe');
				if (mapFrame) {
					mapFrame.addEventListener('click', () => {
						if (typeof window.gtag === 'function') {
							window.gtag('event', 'view_map', { area: 'steinbach' });
						}
					});
				}

				// Modal dismissal: hide modal and restore scroll. Keep submit disabled to avoid re-sends.
				if (dismissModalBtn && submissionModal) {
					dismissModalBtn.addEventListener('click', () => {
						submissionModal.hidden = true;
						document.body.style.overflow = '';
						dismissModalBtn.blur();
					});
					const overlay = submissionModal.querySelector('.submission-modal__overlay');
					if (overlay) {
						overlay.addEventListener('click', () => {
							submissionModal.hidden = true;
							document.body.style.overflow = '';
						});
					}
				}
			</script>
		</main>
		<Footer />
	</body>
</html>