---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScheduleButton from '../components/ScheduleButton.astro';

const HOME_TITLE = 'Driving School in Steinbach, MB | Martens Driving School';
const HOME_DESCRIPTION = 'MPI certified private driving lessons, road test prep, and road test car rental in Steinbach and surrounding communities.';
const HOME_KEYWORDS = 'driving school steinbach, driving instructor steinbach, road test prep steinbach, driving lessons steinbach manitoba';
const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : Astro.url.origin;

const CARLOS_URL = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ3Bb22lvO2Dd7VVH8au87CaqvWWx0zv_2Kr25dL7VFjYB6SRmEe-_di6J5Lc5HB0yK15v2RK1Pj?gv=true';
const NOEMI_URL = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ0GCF6QGO4L0zwJdSa4jLhgFVWUxpr-VRl6GuFievEvfqHMw_Y88vr1-yjn8fJcv2u1BrRbNf-G?gv=true';

const HOME_STRUCTURED_DATA = [
	{
		'@context': 'https://schema.org',
		'@type': 'DrivingSchool',
		name: 'Martens Driving School',
		description: HOME_DESCRIPTION,
		url: `${siteOrigin}/`,
		telephone: '(204) 371-7417, (204) 380-2912',
		email: 'info@martensdrivingschool.ca',
		areaServed: [
			{ '@type': 'City', name: 'Steinbach' },
			{ '@type': 'City', name: 'Blumenort' },
			{ '@type': 'City', name: 'Mitchell' },
			{ '@type': 'City', name: 'La Broquerie' },
			{ '@type': 'City', name: 'New Bothwell' },
			{ '@type': 'City', name: 'Landmark' },
			{ '@type': 'City', name: 'Grunthal' },
			{ '@type': 'City', name: 'Niverville' },
			{ '@type': 'City', name: 'Kleefeld' },
			{ '@type': 'Region', name: 'Southeastern Manitoba' }
		],
		image: `${siteOrigin}/images/logo.jpeg`,
		address: {
			'@type': 'PostalAddress',
			addressLocality: 'Steinbach',
			addressRegion: 'MB',
			addressCountry: 'CA'
		},
		serviceType: ['Driving Lesson', 'Road Test Preparation', 'Road Test Car Rental', 'Adult Driving Lessons', 'Highway Driving Lessons', 'Winter Driving Lessons']
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{
				'@type': 'Question',
				name: 'How much do driving lessons cost?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Driving lessons: Carlos $55/hour; Noemi $70/hour. We offer flexible scheduling to fit your budget and availability.'
				}
			},
			{
				'@type': 'Question',
				name: 'How long is each lesson?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Most lessons are booked in hourly sessions, with options based on your needs and goals. We also offer packages for multiple lessons.'
				}
			},
			{
				'@type': 'Question',
				name: 'Do you provide a vehicle for road tests?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. Road test car rental is available for $100.'
				}
			},
			{
				'@type': 'Question',
				name: 'What areas do you serve?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'We serve Steinbach and surrounding communities including Blumenort, Mitchell, La Broquerie, New Bothwell, Landmark, Grunthal, Niverville, Kleefeld, and throughout Southeastern Manitoba.'
				}
			},
			{
				'@type': 'Question',
				name: 'Can you help if I\'m nervous about driving?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Absolutely. Many of our students start out nervous. We provide patient, judgment-free instruction that builds confidence gradually. We specialize in working with anxious learners.'
				}
			},
			{
				'@type': 'Question',
				name: 'Do you teach adult learners?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. We offer specialized adult driving lessons with no age limit. Adults bring maturity and focus that often helps them progress quickly.'
				}
			},
			{
				'@type': 'Question',
				name: 'What are your hours?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'We\'re available 8am to 9pm, seven days a week. We schedule lessons around your availability.'
				}
			},
			{
				'@type': 'Question',
				name: 'How do I book a lesson?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Fill out the contact form above, email us at info@martensdrivingschool.ca, or text/call Carlos at (204) 380-2912 or Noemi at (204) 371-7417.'
				}
			}
		]
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={HOME_TITLE} description={HOME_DESCRIPTION} keywords={HOME_KEYWORDS} structuredData={HOME_STRUCTURED_DATA} />
	</head>
	<body>
		<Header />
		<main id="top" class="site-main">
			
			<!-- ============================================================
			     1. HERO SECTION (Warm, Personal & Grounded)
			     ============================================================ -->
			<section class="hero-section" aria-labelledby="hero-heading">
				<div class="section-container">
					<div class="hero-inner">
						<h1 id="hero-heading" class="hero-headline">
							Learning to drive should feel comfortable and supportive.
						</h1>

						<p class="hero-subcopy">
							We’re Noemi and Carlos Martens—a mother-and-son, MPI-certified driving school right here in Steinbach. Whether you’re a nervous beginner, an adult learning for the first time, or preparing for your road test, we teach at your pace in a calm, patient environment.
						</p>

						<!-- Dual Direct Booking CTAs: Noemi & Carlos side-by-side -->
						<div class="hero-actions">
							<ScheduleButton variant="split" size="lg" showPriceBadge={true} />
						</div>

						<!-- Translucent Hero Trust Bar -->
						<div class="hero-trust-bar" role="region" aria-label="Key school advantages">
							<span class="hero-trust-item">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>MPI-Certified Instructors</span>
							</span>
							<span class="hero-trust-item">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>25+ Yrs Teaching Experience</span>
							</span>
							<span class="hero-trust-item">
								<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
								<span>Dual-Control 2024 CR-V & 2026 Equinox</span>
							</span>
						</div>
					</div>
				</div>
			</section>


			<!-- ============================================================
			     2. "WHO YOU'LL BE DRIVING WITH" (Soft Coastal Sky Blue)
			     ============================================================ -->
			<section id="instructors" class="section-instructors" aria-labelledby="instructors-heading">
				<!-- Legacy anchor support -->
				<span id="instructor" style="display: block; position: relative; top: -5rem; visibility: hidden;"></span>

				<div class="section-container">
					<div class="section-header section-header--center">
						<h2 id="instructors-heading">Who You’ll Be Driving With</h2>
						<p>
							We’re a local, family-run driving school right here in Steinbach. Every lesson is private, 1-on-1, and taught directly by Noemi or Carlos.
						</p>
					</div>

					<div class="instructors-grid">
						<!-- Instructor 1: Noemi Martens -->
						<div class="instructor-card-warm instructor-card-warm--noemi">
							<div class="instructor-card-header">
								<div class="instructor-photo-frame">
									<img 
										src="/images/instructor.jpg" 
										alt="Noemi Martens, owner and driving instructor at Martens Driving School" 
										class="instructor-photo"
										width="96" 
										height="96" 
										loading="lazy"
									/>
								</div>
								<div class="instructor-meta">
									<h3>Noemi Martens</h3>
									<div class="instructor-subtitle">Founder, MPI-Certified Instructor & Active Manitoba High School Teacher (25+ Years)</div>
								</div>
							</div>

							<div class="instructor-vehicle-pill">
								<span>🚗 Training Vehicle: Black 2024 Honda CR-V Hybrid EX-L (Dual-Control)</span>
							</div>

							<p class="instructor-bio-text">
								Hi, I’m Noemi. Alongside running Martens Driving School, I’m an active Manitoba high school teacher with over 25 years of classroom experience. Teaching is what I truly love, and I believe learning to drive should never involve yelling, pressure, or feeling embarrassed. I specialize in working with nervous beginners and adult learners, creating a patient, step-by-step space where you can relax and build genuine confidence behind the wheel.
							</p>

							<div class="instructor-card-cta">
								<a href={NOEMI_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" aria-label="Book a driving lesson with Noemi Martens for $70 per hour">
									<span>Book with Noemi ($70/hr)</span>
								</a>
							</div>
						</div>

						<!-- Instructor 2: Carlos Martens -->
						<div class="instructor-card-warm instructor-card-warm--carlos">
							<div class="instructor-card-header">
								<div class="instructor-photo-frame">
									<img 
										src="/images/instructor-carlos.jpg" 
										alt="Carlos Martens, driving instructor at Martens Driving School" 
										class="instructor-photo"
										width="96" 
										height="96" 
										loading="lazy"
									/>
								</div>
								<div class="instructor-meta">
									<h3>Carlos Martens</h3>
									<div class="instructor-subtitle">MPI-Certified Instructor & Road Test Prep</div>
								</div>
							</div>

							<div class="instructor-vehicle-pill">
								<span>⚡ Training Vehicle: Grey 2026 Chevy Equinox EV (Dual-Control)</span>
							</div>

							<p class="instructor-bio-text">
								Hi, I’m Carlos. My focus is on clear, practical, hands-on driving skills that prepare you for the real world—not just passing a test. Whether we’re practicing Steinbach intersections, highway merging on Highway 12, parallel parking, or mastering the core maneuvers evaluated on the MPI road test, I keep lessons calm and structured so you always know what to expect.
							</p>

							<div class="instructor-card-cta">
								<a href={CARLOS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" aria-label="Book a driving lesson with Carlos Martens for $55 per hour">
									<span>Book with Carlos ($55/hr)</span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>


			<!-- ============================================================
			     3. "WHAT YOU'LL BE DRIVING" (Warm Alabaster Photo Showcase)
			     ============================================================ -->
			<section id="vehicles" class="section-vehicles" aria-labelledby="vehicles-heading">
				<div class="section-container">
					<div class="section-header section-header--center">
						<h2 id="vehicles-heading">Comfortable, Modern & Safe Training Vehicles</h2>
						<p>
							Both of our vehicles are equipped with passenger-side dual safety brakes, automatic transmissions, and modern visibility aids so you can learn with complete peace of mind.
						</p>
					</div>

					<div class="vehicles-grid">
						<!-- Vehicle 1: Noemi's CR-V Hybrid & Road Test Rental -->
						<div class="vehicle-card">
							<div class="vehicle-card-media">
								<img 
									src="/images/crv-hybrid.jpg" 
									alt="Shiny Black 2024 Honda CR-V Hybrid EX-L training vehicle" 
									class="vehicle-card-img"
									width="720"
									height="450"
									loading="lazy"
								/>
								<span class="vehicle-badge-overlay">Noemi’s Vehicle • Available for MPI Road Test Rental</span>
							</div>
							<div class="vehicle-card-body">
								<h3 class="vehicle-title">2024 Honda CR-V Hybrid EX-L (Black)</h3>
								
								<div class="vehicle-pills-list">
									<span class="vehicle-pill">Passenger Dual-Control Brake</span>
									<span class="vehicle-pill">Smooth Hybrid AWD</span>
									<span class="vehicle-pill">EX-L Leather Comfort</span>
									<span class="vehicle-pill">Blind-Spot & Backup Cameras</span>
								</div>

								<p class="vehicle-description">
									A quiet, comfortable, and confidence-inspiring SUV with commanding road visibility. Available for all of Noemi's lessons as well as our $100 MPI Road Test Car Rental package.
								</p>

								<div class="vehicle-card-action">
									<a href={NOEMI_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" aria-label="Book a lesson with Noemi in the 2024 Honda CR-V Hybrid">
										<span>Book Noemi's Lesson ($70/hr)</span>
									</a>
								</div>
							</div>
						</div>

						<!-- Vehicle 2: Carlos's Equinox EV -->
						<div class="vehicle-card">
							<div class="vehicle-card-media">
								<img 
									src="/images/equinox-ev.jpg" 
									alt="Metallic Grey 2026 Chevrolet Equinox EV electric training vehicle" 
									class="vehicle-card-img"
									width="720"
									height="450"
									loading="lazy"
								/>
								<span class="vehicle-badge-overlay vehicle-badge-overlay--carlos">Carlos’s Vehicle • All-Electric & Ultra-Smooth</span>
							</div>
							<div class="vehicle-card-body">
								<h3 class="vehicle-title">2026 Chevrolet Equinox EV (Grey)</h3>

								<div class="vehicle-pills-list">
									<span class="vehicle-pill">Passenger Dual-Control Brake</span>
									<span class="vehicle-pill">100% Electric & Whisper Quiet</span>
									<span class="vehicle-pill">High-Def Surround Vision</span>
									<span class="vehicle-pill">Effortless Handling</span>
								</div>

								<p class="vehicle-description">
									With zero engine noise or shifting vibrations, the all-electric 2026 Equinox EV creates an exceptionally calm cabin environment—helping nervous learners stay focused on Steinbach roads, highway merges, and parking.
								</p>

								<div class="vehicle-card-action">
									<a href={CARLOS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" aria-label="Book a lesson with Carlos in the 2026 Chevrolet Equinox EV">
										<span>Book Carlos's Lesson ($55/hr)</span>
									</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>


			<!-- ============================================================
			     4. "STRAIGHTFORWARD LESSONS & RATES" (Rich Prussian Feature)
			     ============================================================ -->
			<section id="services" class="section-rates-feature" aria-labelledby="services-heading">
				<div class="section-container">
					<div class="section-header section-header--center">
						<h2 id="services-heading">Straightforward Lessons & Rates</h2>
						<p>
							Simple hourly booking with no hidden fees or complicated packages.
						</p>
					</div>

					<div class="rates-grid">
						<!-- Lesson 1: Noemi -->
						<div class="rate-card">
							<div class="rate-card-top">
								<h3 class="rate-title">Driving Lesson</h3>
								<div class="rate-instructor">Instructor: Noemi Martens (Founder)</div>
								<div class="rate-price-row">
									<span class="rate-amount">$70</span>
									<span class="rate-unit">/ hour</span>
								</div>
							</div>

							<ul class="rate-features">
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Private, patient, judgment-free instruction</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Grounded in 25+ years of active high school classroom teaching experience</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Specialized, gentle guidance for nervous beginners and adult learners</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Learner vehicle: Black 2024 Honda CR-V Hybrid EX-L</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Flexible appointments 7 days a week (8am – 9pm)</span>
								</li>
							</ul>

							<div class="rate-card-action">
								<a href={NOEMI_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" aria-label="Book 1-hour driving lesson with Noemi Martens for $70">
									<span>Book with Noemi ($70/hr)</span>
								</a>
							</div>
						</div>

						<!-- Lesson 2: Carlos -->
						<div class="rate-card">
							<div class="rate-card-top">
								<h3 class="rate-title">Driving Lesson</h3>
								<div class="rate-instructor">Instructor: Carlos Martens</div>
								<div class="rate-price-row">
									<span class="rate-amount">$55</span>
									<span class="rate-unit">/ hour</span>
								</div>
							</div>

							<ul class="rate-features">
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Private, calm 1-on-1 personalized in-car instruction</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Tailored directly to your current comfort and experience level</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Practical real-world skills: parking, highway merging, gravel roads</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Learner vehicle: Grey 2026 Chevrolet Equinox EV</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Flexible appointments 7 days a week (8am – 9pm)</span>
								</li>
							</ul>

							<div class="rate-card-action">
								<a href={CARLOS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" aria-label="Book 1-hour driving lesson with Carlos Martens for $55">
									<span>Book with Carlos ($55/hr)</span>
								</a>
							</div>
						</div>

						<!-- Package 3: Road Test Car Rental -->
						<div class="rate-card rate-card--highlight">
							<div class="rate-card-top">
								<span class="rate-ribbon-badge">Includes Pick-Up & Drop-Off</span>
								<h3 class="rate-title">MPI Road Test Car Rental</h3>
								<div class="rate-instructor">Instructors: Carlos / Noemi</div>
								<div class="rate-price-row">
									<span class="rate-amount">$100</span>
									<span class="rate-unit">flat rate</span>
								</div>
							</div>

							<ul class="rate-features">
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Use our certified vehicle for your official Steinbach MPI road test</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Dual-controlled 2024 Honda CR-V Hybrid EX-L vehicle</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Pick-up and drop-off service in Steinbach included</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Pre-test warm-up drive right before your test to settle exam jitters</span>
								</li>
								<li>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<polyline points="20 6 9 17 4 12"></polyline>
									</svg>
									<span>Available to both new and continuing students</span>
								</li>
							</ul>

							<div class="rate-card-action">
								<a href="#contact" class="btn btn-outline" aria-label="Reserve car rental for your MPI road test">
									<span>Reserve for Road Test</span>
								</a>
							</div>
						</div>
					</div>
				</div>
			</section>


			<!-- ============================================================
			     5. "HOW WE TEACH" & FAQ (Soft Coastal Sky Blue)
			     ============================================================ -->
			<section id="why-us" class="section-teach-faq" aria-labelledby="why-us-heading">
				<div class="section-container">
					<div class="section-header section-header--center">
						<h2 id="why-us-heading">How We Teach</h2>
						<p>
							A calm, patient approach designed to build real confidence behind the wheel.
						</p>
					</div>

					<div class="how-we-teach-grid">
						<!-- Point 1 -->
						<div class="teach-block">
							<span class="teach-number" aria-hidden="true">01</span>
							<h3>No Yelling, No Rush</h3>
							<p>
								Learning a new skill takes time. We explain things clearly, answer every question, and never make you feel bad for making a mistake. You learn at your own pace with zero pressure.
