---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScheduleButton from '../components/ScheduleButton.astro';

const HOME_TITLE = 'Driving School in Steinbach, MB | Martens Driving School';
const HOME_DESCRIPTION = 'MPI certified private driving lessons, road test prep, and road test car rental in Steinbach and surrounding communities.';
const HOME_KEYWORDS = 'driving school steinbach, driving instructor steinbach, road test prep steinbach, driving lessons steinbach manitoba';
const siteOrigin = Astro.site ? Astro.site.toString().replace(/\/$/, '') : Astro.url.origin;

const CARLOS_URL = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ3Bb22lvO2Dd7VVH8au87CaqvWWx0zv_2Kr25dL7VFjYB6SRmEe-_di6J5Lc5HB0yK15v2RK1Pj?gv=true';
const NOEMI_URL = 'https://calendar.google.com/calendar/appointments/schedules/AcZssZ0GCF6QGO4L0zwJdSa4jLhgFVWUxpr-VRl6GuFievEvfqHMw_Y88vr1-yjn8fJcv2u1BrRbNf-G?gv=true';

const HOME_STRUCTURED_DATA = [
	{
		'@context': 'https://schema.org',
		'@type': 'DrivingSchool',
		name: 'Martens Driving School',
		description: HOME_DESCRIPTION,
		url: `${siteOrigin}/`,
		telephone: '(204) 371-7417, (204) 380-2912',
		email: 'info@martensdrivingschool.ca',
		areaServed: [
			{ '@type': 'City', name: 'Steinbach' },
			{ '@type': 'City', name: 'Blumenort' },
			{ '@type': 'City', name: 'Mitchell' },
			{ '@type': 'City', name: 'La Broquerie' },
			{ '@type': 'City', name: 'New Bothwell' },
			{ '@type': 'City', name: 'Landmark' },
			{ '@type': 'City', name: 'Grunthal' },
			{ '@type': 'City', name: 'Niverville' },
			{ '@type': 'City', name: 'Kleefeld' },
			{ '@type': 'Region', name: 'Southeastern Manitoba' }
		],
		image: `${siteOrigin}/images/logo.jpeg`,
		address: {
			'@type': 'PostalAddress',
			addressLocality: 'Steinbach',
			addressRegion: 'MB',
			addressCountry: 'CA'
		},
		serviceType: ['Driving Lesson', 'Road Test Preparation', 'Road Test Car Rental', 'Adult Driving Lessons', 'Highway Driving Lessons', 'Winter Driving Lessons']
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: [
			{
				'@type': 'Question',
				name: 'How much do driving lessons cost?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Driving lessons: Carlos $55/hour; Noemi $70/hour. We offer flexible scheduling to fit your budget and availability.'
				}
			},
			{
				'@type': 'Question',
				name: 'How long is each lesson?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Most lessons are booked in hourly sessions, with options based on your needs and goals. We also offer packages for multiple lessons.'
				}
			},
			{
				'@type': 'Question',
				name: 'Do you provide a vehicle for road tests?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. Road test car rental is available for $100.'
				}
			},
			{
				'@type': 'Question',
				name: 'What areas do you serve?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'We serve Steinbach and surrounding communities including Blumenort, Mitchell, La Broquerie, New Bothwell, Landmark, Grunthal, Niverville, Kleefeld, and throughout Southeastern Manitoba.'
				}
			},
			{
				'@type': 'Question',
				name: 'Can you help if I\'m nervous about driving?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Absolutely. Many of our students start out nervous. We provide patient, judgment-free instruction that builds confidence gradually. We specialize in working with anxious learners.'
				}
			},
			{
				'@type': 'Question',
				name: 'Do you teach adult learners?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Yes. We offer specialized adult driving lessons with no age limit. Adults bring maturity and focus that often helps them progress quickly.'
				}
			},
			{
				'@type': 'Question',
				name: 'What are your hours?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'We\'re available 8am to 9pm, seven days a week. We schedule lessons around your availability.'
				}
			},
			{
				'@type': 'Question',
				name: 'How do I book a lesson?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'Fill out the contact form above, email us at info@martensdrivingschool.ca, or text/call Carlos at (204) 380-2912 or Noemi at (204) 371-7417.'
				}
			}
		]
	}
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={HOME_TITLE} description={HOME_DESCRIPTION} keywords={HOME_KEYWORDS} structuredData={HOME_STRUCTURED_DATA} />
	</head>
	<body>
		<Header />
		<main id="top" class="site-main">
			
			<!-- ============================================================
			     1. HIGH-CONVERTING HERO SECTION (Linear / Dark Surface Depth)
			     ============================================================ -->
			<section class="hero-section" aria-labelledby="hero-heading">
				<div class="hero-backdrop-glow" aria-hidden="true"></div>
				<div class="section-container">
					<div class="hero-content">
						<!-- Eyebrow Pill Badge -->
						<div class="eyebrow-badge eyebrow-badge--dark">
							<span class="badge-dot" aria-hidden="true"></span>
							<span>MPI-Certified Driving Instruction • Steinbach & Southeastern MB</span>
						</div>

						<!-- Main Headline -->
						<h1 id="hero-heading" class="hero-headline">
							Learning to drive should feel comfortable and supportive.
						</h1>

						<!-- Subcopy -->
						<p class="hero-lead">
							At Martens Driving School, our mission is to build lifelong road confidence in a calm, judgment-free environment—not just help you pass a test. Every private in-car lesson is tailored to your pace and comfort level across Steinbach and Southeastern Manitoba.
						</p>

						<!-- Dual-Instructor CTA Architecture -->
						<div class="hero-actions">
							<ScheduleButton variant="split" size="lg" showPriceBadge={true} />
						</div>

						<!-- Trust Micro-Bar -->
						<div class="trust-micro-bar" role="region" aria-label="Key school advantages">
							<div class="trust-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
									<polyline points="9 12 11 14 15 10"></polyline>
								</svg>
								<span>MPI-Certified Instructors</span>
							</div>
							<div class="trust-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<circle cx="12" cy="8" r="7"></circle>
									<polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
								</svg>
								<span>25+ Years Classroom Teaching Pedagogy</span>
							</div>
							<div class="trust-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<rect x="2" y="5" width="20" height="14" rx="2"></rect>
									<line x1="2" y1="10" x2="22" y2="10"></line>
								</svg>
								<span>2024 Honda CR-V Hybrid Dual-Control Vehicle</span>
							</div>
						</div>
					</div>
				</div>
			</section>


			<!-- ============================================================
			     2. "WHY LEARN WITH US" VALUE PILLARS (Bento Grid)
			     ============================================================ -->
			<section id="why-us" class="section-container" aria-labelledby="why-us-heading">
				<div class="section-header">
					<div class="eyebrow-badge eyebrow-badge--dark">
						<span class="badge-dot" aria-hidden="true"></span>
						<span>The Martens Difference</span>
					</div>
					<h2 id="why-us-heading">Why Learn With Us</h2>
					<p>
						Instruction built on patience, professional pedagogy, and real-world Southeastern Manitoba road mastery.
					</p>
				</div>

				<div class="bento-grid">
					<!-- Bento Card 1: Teacher-Led Patience -->
					<div class="bento-card bento-col-6">
						<div class="bento-card-header">
							<div class="bento-icon-wrapper" aria-hidden="true">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
									<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
								</svg>
							</div>
							<h3>Teacher-Led Patience</h3>
						</div>
						<p>
							Instruction rooted in professional classroom pedagogy—zero yelling, zero intimidation, and total respect. Our methods break down complex road situations into clear, digestible steps so you stay relaxed and receptive behind the wheel.
						</p>
					</div>

					<!-- Bento Card 2: Nervous & Adult Learners -->
					<div class="bento-card bento-col-6">
						<div class="bento-card-header">
							<div class="bento-icon-wrapper" aria-hidden="true">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
								</svg>
							</div>
							<h3>Tailored for Nervous & Adult Learners</h3>
						</div>
						<p>
							Whether you have driving anxiety or are starting later in life, our sessions are paced specifically to replace stress with calm competence. There is no age limit to learning, and we progress strictly at your comfort level.
						</p>
					</div>

					<!-- Bento Card 3: Local Route Mastery -->
					<div class="bento-card bento-col-6">
						<div class="bento-card-header">
							<div class="bento-icon-wrapper" aria-hidden="true">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="10" r="3"></circle>
									<path d="M12 21.7C17.3 17 20 13 20 10a8 8 0 1 0-16 0c0 3 2.7 7 8 11.7z"></path>
								</svg>
							</div>
							<h3>Local Steinbach Route Mastery</h3>
						</div>
						<p>
							Practical preparation for real-world Southeastern Manitoba conditions—navigating busy Main Street and Highway 12, highway merging, rural gravel roads, roundabouts, and the exact intersections evaluated on the MPI road test.
						</p>
					</div>

					<!-- Bento Card 4: Modern Dual-Control Hybrid -->
					<div class="bento-card bento-col-6">
						<div class="bento-card-header">
							<div class="bento-icon-wrapper" aria-hidden="true">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"></path>
									<circle cx="7" cy="17" r="2"></circle>
									<path d="M9 17h6"></path>
									<circle cx="17" cy="17" r="2"></circle>
								</svg>
							</div>
							<h3>2024 Honda CR-V Hybrid Safety</h3>
						</div>
						<p>
							Train and test in our pristine, fully dual-controlled 2024 Honda CR-V Hybrid. Equipped with instructor-side dual braking and modern active safety features, you can drive with complete peace of mind from day one.
						</p>
					</div>
				</div>
			</section>


			<!-- ============================================================
			     3. SERVICES & TRANSPARENT PRICING CARDS (Bento Tiered Layout)
			     ============================================================ -->
			<section id="services" class="section-container services-section" aria-labelledby="services-heading">
				<div class="section-header">
					<div class="eyebrow-badge eyebrow-badge--dark">
						<span class="badge-dot" aria-hidden="true"></span>
						<span>Transparent Pricing</span>
					</div>
					<h2 id="services-heading">Driving Lessons & Services</h2>
					<p>
						No hidden fees. Book single lessons at your own pace or reserve our dual-controlled vehicle for your official road test.
					</p>
				</div>

				<div class="services-grid-modern">
					<!-- Service Card 1: Carlos -->
					<div class="pricing-card">
						<div class="pricing-card-header">
							<span class="pricing-badge">1-on-1 In-Car Training</span>
							<h3 class="pricing-title">Driving Lesson</h3>
							<div class="pricing-instructor">Instructor: Carlos Martens</div>
							<div class="pricing-price-row">
								<span class="pricing-amount">$55</span>
								<span class="pricing-unit">/ hour</span>
							</div>
						</div>

						<ul class="pricing-features">
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Private, calm 1-on-1 personalized instruction</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Tailored to your current experience level</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Practical real-world skill building & road confidence</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Steinbach & Southeastern Manitoba route practice</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Flexible scheduling 8am – 9pm, 7 days a week</span>
							</li>
						</ul>

						<div class="pricing-cta-container">
							<a href={CARLOS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-navy" aria-label="Book a driving lesson with Carlos Martens for $55 per hour">
								<span>Book with Carlos</span>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<line x1="5" y1="12" x2="19" y2="12"></line>
									<polyline points="12 5 19 12 12 19"></polyline>
								</svg>
							</a>
						</div>
					</div>

					<!-- Service Card 2: Noemi (Featured) -->
					<div class="pricing-card pricing-card--featured">
						<div class="featured-pill">Specialist Pedagogy</div>
						<div class="pricing-card-header">
							<span class="pricing-badge">1-on-1 In-Car Training</span>
							<h3 class="pricing-title">Driving Lesson</h3>
							<div class="pricing-instructor">Instructor: Noemi Martens (Owner)</div>
							<div class="pricing-price-row">
								<span class="pricing-amount">$70</span>
								<span class="pricing-unit">/ hour</span>
							</div>
						</div>

						<ul class="pricing-features">
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Private, patient, judgment-free instruction</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>25+ years professional Manitoba teaching pedagogy</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Specialized guidance for anxious & adult learners</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Progressive road test mastery & confidence drills</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Flexible scheduling 8am – 9pm, 7 days a week</span>
							</li>
						</ul>

						<div class="pricing-cta-container">
							<a href={NOEMI_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary" aria-label="Book a driving lesson with Noemi Martens for $70 per hour">
								<span>Book with Noemi</span>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<line x1="5" y1="12" x2="19" y2="12"></line>
									<polyline points="12 5 19 12 12 19"></polyline>
								</svg>
							</a>
						</div>
					</div>

					<!-- Service Card 3: Road Test Car Rental -->
					<div class="pricing-card">
						<div class="pricing-card-header">
							<span class="pricing-badge">Exam Package</span>
							<h3 class="pricing-title">Road Test Car Rental</h3>
							<div class="pricing-instructor">Instructors: Carlos / Noemi</div>
							<div class="pricing-price-row">
								<span class="pricing-amount">$100</span>
								<span class="pricing-unit">flat rate</span>
							</div>
						</div>

						<ul class="pricing-features">
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Vehicle provided for official MPI road test in Steinbach</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Dual-controlled 2024 Honda CR-V Hybrid vehicle</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Convenient pick-up & drop-off service included</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Pre-test warm-up drive to settle exam nerves</span>
							</li>
							<li class="pricing-feature-item">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="20 6 9 17 4 12"></polyline>
								</svg>
								<span>Stress-free vehicle inspection pass guarantee</span>
							</li>
						</ul>

						<div class="pricing-cta-container">
							<a href="/#contact" class="btn btn-navy" aria-label="Inquire or reserve car rental for MPI road test">
								<span>Reserve for Road Test</span>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<line x1="5" y1="12" x2="19" y2="12"></line>
									<polyline points="12 5 19 12 12 19"></polyline>
								</svg>
							</a>
						</div>
					</div>
				</div>

				<p class="services-footer-note">
					Whether you are just starting to learn or preparing for your road test, our lessons focus on real-world driving skills that will help you feel comfortable on the road for life.
				</p>
			</section>


			<!-- ============================================================
			     4. "MEET YOUR INSTRUCTORS" (Editorial Profile Cards)
			     ============================================================ -->
			<section id="instructors" class="section-container" aria-labelledby="instructors-heading">
				<!-- Hidden anchor target for backward compatibility with #instructor -->
				<span id="instructor" style="display: block; position: relative; top: -5.5rem; visibility: hidden;"></span>

				<div class="section-header">
					<div class="eyebrow-badge eyebrow-badge--dark">
						<span class="badge-dot" aria-hidden="true"></span>
						<span>Experienced Educators</span>
					</div>
					<h2 id="instructors-heading">Meet Your Instructors</h2>
					<p>
						Dedicated to patient, personalized driving instruction that respects your pace and builds genuine confidence.
					</p>
				</div>

				<div class="instructors-grid-modern">
					<!-- Instructor 1: Noemi Martens -->
					<div class="instructor-editorial-card">
