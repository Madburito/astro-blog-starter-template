---
import { SITE_TITLE } from '../consts';
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <!-- Left: Brand Logo Emblem & Wordmark with "Steinbach, MB" sub-label -->
    <div class="header-left">
      <a href="/#top" class="brand-link" aria-label="Martens Driving School - Return to top">
        <div class="brand-logo-frame">
          <img src="/images/logo.jpeg" alt="Martens Driving School Logo" class="brand-logo" width="40" height="40" />
        </div>
        <div class="brand-text-block">
          <span class="brand-text">{SITE_TITLE}</span>
          <span class="brand-sublabel">Steinbach, MB</span>
        </div>
      </a>
    </div>

    <!-- Center: Clean Anchor Navigation Links (Desktop) -->
    <nav id="primary-nav" class="desktop-nav" aria-label="Primary navigation">
      <a href="/#instructors" class="nav-link">Meet Us</a>
      <a href="/#vehicles" class="nav-link">Our Vehicles</a>
      <a href="/#services" class="nav-link">Lessons & Rates</a>
      <a href="/#faq" class="nav-link">FAQ</a>
      <a href="/#contact" class="nav-link">Contact</a>
    </nav>

    <!-- Right: Book a Lesson CTA Button (Desktop) & Mobile Hamburger Toggle -->
    <div class="header-right">
      <a href="/#services" class="btn btn-primary btn-sm header-cta desktop-only">
        <span>Book a Lesson</span>
      </a>

      <!-- Mobile Hamburger Toggle (Viewport < 768px) -->
      <button 
        id="mobile-nav-toggle"
        class="mobile-toggle mobile-only" 
        type="button"
        aria-label="Toggle navigation" 
        aria-expanded="false" 
        aria-controls="mobile-nav-drawer" 
      >
        <span class="hamburger-box" aria-hidden="true">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Backdrop & Drawer (Strictly Gated for Viewports < 768px) -->
  <div id="mobile-nav-backdrop" class="mobile-backdrop mobile-only" aria-hidden="true"></div>
  
  <aside 
    id="mobile-nav-drawer" 
    class="mobile-drawer mobile-only" 
    role="dialog" 
    aria-modal="true" 
    aria-label="Mobile Navigation Menu"
    tabindex="-1"
  >
    <div class="mobile-drawer-header">
      <div class="brand-logo-frame brand-logo-frame--sm">
        <img src="/images/logo.jpeg" alt="" class="brand-logo" width="34" height="34" />
      </div>
      <div class="brand-text-block">
        <span class="brand-text">{SITE_TITLE}</span>
        <span class="brand-sublabel">Steinbach, MB</span>
      </div>
      <button id="mobile-drawer-close" class="drawer-close-btn" type="button" aria-label="Close navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    
    <nav class="mobile-drawer-links" aria-label="Mobile Navigation Links">
      <a href="/#instructors" class="mobile-link">Meet Us</a>
      <a href="/#vehicles" class="mobile-link">Our Vehicles</a>
      <a href="/#services" class="mobile-link">Lessons & Rates</a>
      <a href="/#faq" class="mobile-link">FAQ</a>
      <a href="/#contact" class="mobile-link">Contact</a>
    </nav>

    <div class="mobile-drawer-footer">
      <a href="/#services" class="btn btn-primary btn-lg mobile-cta-full">
        <span>Book a Lesson</span>
      </a>

      <div class="mobile-drawer-phone">
        <span class="phone-label">Call or Text:</span>
        <a href="tel:+12043802912" class="phone-link">Carlos: (204) 380-2912</a>
        <a href="tel:+12043717417" class="phone-link">Noemi: (204) 371-7417</a>
      </div>
    </div>
  </aside>
</header>

<style>
  /* Header Container: White Background with 4px Navy Top Border */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 4px solid var(--navy-brand);
    border-bottom: 1px solid var(--border-warm);
    box-shadow: 0 2px 12px rgba(29, 53, 87, 0.06);
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .site-header.is-open {
    backdrop-filter: none !important;
    -webkit-backdrop-filter: none !important;
  }

  .header-inner {
    max-width: var(--max-content-width);
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* 3-Part Layout */
  .header-left {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .desktop-nav {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .header-right {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  /* Brand Link & Wordmark */
  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none !important;
    color: var(--navy-brand);
  }

  .brand-logo-frame {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--border-warm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background-color: #FFFFFF;
  }

  .brand-logo-frame--sm {
    width: 34px;
    height: 34px;
  }

  .brand-logo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .brand-text-block {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .brand-text {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy-brand);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .brand-sublabel {
    font-size: 0.775rem;
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* Desktop Anchor Navigation Links */
  .nav-link {
    font-size: 0.925rem;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none !important;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--navy-brand);
    background-color: var(--bg-section-alt);
  }

  .header-cta {
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* =========================================================================
     VIEWPORT GATING: Desktop (>= 960px) vs Mobile (< 960px)
     ========================================================================= */

  /* DEFAULT FOR VIEWPORTS >= 960px: Mobile Drawer/Backdrop strictly non-existent */
  @media (min-width: 960px) {
    .mobile-only {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
      opacity: 0 !important;
      width: 0 !important;
      height: 0 !important;
      position: absolute !important;
    }

    .desktop-only {
      display: inline-flex !important;
    }

    .desktop-nav {
      display: flex !important;
    }
  }

  /* MOBILE VIEWPORTS (< 960px) */
  @media (max-width: 959.98px) {
    .desktop-only {
      display: none !important;
    }

    .desktop-nav {
      display: none !important;
    }

    .header-inner {
      padding: 0.75rem 1rem;
    }

    .brand-text {
      font-size: 1.05rem;
    }

    /* Hamburger Toggle Button */
    .mobile-toggle {
      display: inline-flex !important;
      background-color: #FFFFFF;
      border: 1px solid var(--border-warm);
      color: var(--navy-brand);
      width: 40px;
      height: 40px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      align-items: center;
      justify-content: center;
      padding: 0;
      flex-shrink: 0;
      transition: background-color 0.15s ease;
    }

    .mobile-toggle:hover {
      background-color: var(--bg-section-alt);
    }

    .hamburger-box {
      display: flex;
      flex-direction: column;
      gap: 5px;
      width: 20px;
    }

    .hamburger-line {
      display: block;
      width: 100%;
      height: 2px;
      background-color: var(--navy-brand);
      border-radius: 2px;
    }

    /* Mobile Backdrop */
    .mobile-backdrop {
      display: block !important;
      position: fixed;
      inset: 0;
      background-color: rgba(29, 53, 87, 0.4);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      z-index: 99;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.25s ease, visibility 0.25s;
    }

    .mobile-backdrop.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    /* Mobile Drawer */
    .mobile-drawer {
      display: flex !important;
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 300px;
      max-width: 85vw;
      height: 100vh;
      height: 100dvh;
      overflow-y: auto;
      background-color: #FAF8F5;
      border-left: 1px solid var(--border-warm);
      box-shadow: -8px 0 24px rgba(0, 0, 0, 0.1);
      z-index: 100;
      flex-direction: column;
      padding: 1.5rem;
      gap: 1.5rem;
      transform: translateX(100%);
      visibility: hidden;
      pointer-events: none;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
    }

    .mobile-drawer.is-open {
      transform: translateX(0);
      visibility: visible;
      pointer-events: auto;
    }

    .mobile-drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border-warm);
      gap: 0.75rem;
    }

    .drawer-close-btn {
      background-color: #FFFFFF;
      border: 1px solid var(--border-warm);
      color: var(--navy-brand);
      width: 36px;
      height: 36px;
      border-radius: 50%;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-left: auto;
      transition: background-color 0.15s ease;
    }

    .drawer-close-btn:hover {
      background-color: var(--bg-section-alt);
    }

    .mobile-drawer-links {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .mobile-link {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--navy-brand);
      text-decoration: none !important;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
      background-color: #FFFFFF;
      border: 1px solid var(--border-warm);
      transition: background-color 0.15s ease;
    }

    .mobile-link:hover {
      background-color: var(--bg-section-alt);
    }

    .mobile-drawer-footer {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .mobile-cta-full {
      width: 100%;
    }

    .mobile-drawer-phone {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      background-color: #FFFFFF;
      border: 1px solid var(--border-warm);
      padding: 0.85rem 1rem;
      border-radius: var(--radius-sm);
    }

    .phone-label {
      font-size: 0.8rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--text-muted);
    }

    .phone-link {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--navy-brand);
      text-decoration: none !important;
    }

    .phone-link:hover {
      color: var(--red-cta);
    }
  }
</style>

<script>
  function initNavigation() {
    const toggleBtn = document.getElementById('mobile-nav-toggle');
    const closeBtn = document.getElementById('mobile-drawer-close');
    const drawer = document.getElementById('mobile-nav-drawer');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const siteHeader = document.getElementById('site-header');

    if (!toggleBtn || !drawer || !backdrop) return;

    function openDrawer() {
      drawer.classList.add('is-open');
      backdrop.classList.add('is-open');
      siteHeader?.classList.add('is-open');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      siteHeader?.classList.remove('is-open');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      toggleBtn?.focus();
    }

    toggleBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.contains('is-open');
      if (isOpen) {
        closeDrawer();
      } else {
        openDrawer();
      }
    });

    closeBtn?.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    // Close when tapping any link inside the mobile drawer
    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });

    // Automatically close if screen resized to desktop viewport (>= 960px)
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 960 && drawer.classList.contains('is-open')) {
        drawer.classList.remove('is-open');
        backdrop.classList.remove('is-open');
        siteHeader?.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavigation);
  } else {
    initNavigation();
  }
  document.addEventListener('astro:page-load', initNavigation);
</script>
