---
const today = new Date();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-top">
      <!-- Brand column -->
      <div class="footer-brand-col">
        <a href="/#top" class="footer-brand-link">
          <div class="footer-logo-frame">
            <img src="/images/logo.jpeg" alt="Martens Driving School" class="footer-logo" width="40" height="40" />
          </div>
          <div class="footer-brand-text-wrap">
            <span class="footer-brand-name">Martens Driving School</span>
            <span class="footer-location-tag">Steinbach & Southeastern MB</span>
          </div>
        </a>
        <p class="footer-tagline">
          A small, family-owned driving school in Steinbach, Manitoba. MPI-certified driving instruction and road test vehicle rental in a calm, patient, and judgment-free environment.
        </p>
        <div class="footer-trust-badge">
          <span>MPI-Certified Instructors • Dual-Control 2024 Honda CR-V</span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="footer-links-col">
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-nav-list">
          <li><a href="/#services">Lessons & Rates</a></li>
          <li><a href="/#instructors">Meet Noemi & Carlos</a></li>
          <li><a href="/#why-us">How We Teach</a></li>
          <li><a href="/#service-area">Service Area</a></li>
          <li><a href="/#faq">Questions & Answers</a></li>
          <li><a href="/#contact">Get in Touch</a></li>
        </ul>
      </div>

      <!-- Contact details -->
      <div class="footer-contact-col">
        <h4 class="footer-heading">Reach Out Directly</h4>
        <ul class="footer-contact-list">
          <li>
            <span class="contact-label">Call or Text Carlos:</span>
            <a href="tel:+12043802912">(204) 380-2912</a>
          </li>
          <li>
            <span class="contact-label">Text Noemi:</span>
            <a href="tel:+12043717417">(204) 371-7417</a>
          </li>
          <li>
            <span class="contact-label">Email:</span>
            <a href="mailto:info@martensdrivingschool.ca">info@martensdrivingschool.ca</a>
          </li>
          <li>
            <span class="contact-label">Hours:</span>
            <span>Mon–Sat: 8:00 AM – 9:00 PM<br/>Sun: 8:00 AM – 7:00 PM</span>
          </li>
        </ul>

        <div class="footer-social-wrap">
          <a 
            href="https://www.instagram.com/martensdrivingschool/" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="footer-social-btn" 
            aria-label="Follow Martens Driving School on Instagram"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.5" y2="6.5"></line>
            </svg>
            <span>@martensdrivingschool</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom copyright row -->
    <div class="footer-bottom">
      <p class="copyright-text">
        &copy; {today.getFullYear()} Martens Driving School. All rights reserved.
      </p>
      <p class="footer-subtext">
        Steinbach, Manitoba, Canada • MPI Certified Private In-Car Driving Lessons
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--navy-brand);
    color: #FAF8F5;
    padding: 4.5rem 1.5rem 5rem;
    position: relative;
    z-index: 10;
  }

  .footer-container {
    max-width: var(--max-content-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1.25fr;
    gap: 3rem;
  }

  /* Brand col */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .footer-brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none !important;
    color: #FFFFFF;
  }

  .footer-logo-frame {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.3);
    background-color: #FFFFFF;
    flex-shrink: 0;
  }

  .footer-logo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-brand-text-wrap {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .footer-brand-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .footer-location-tag {
    font-size: 0.8rem;
    color: #CBD5E1;
  }

  .footer-tagline {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #E2DDD5;
    max-width: 42ch;
    margin: 0;
  }

  .footer-trust-badge {
    display: inline-flex;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 0.4rem 0.85rem;
    border-radius: var(--radius-sm);
    font-size: 0.825rem;
    font-weight: 600;
    color: #FFFFFF;
    width: fit-content;
  }

  /* Headings */
  .footer-heading {
    font-size: 0.95rem;
    font-weight: 700;
    color: #FFFFFF;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1.25rem;
  }

  /* Nav lists */
  .footer-nav-list,
  .footer-contact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav-list a {
    color: #CBD5E1;
    text-decoration: none !important;
    font-size: 0.95rem;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-block;
  }

  .footer-nav-list a:hover {
    color: #FFFFFF;
    transform: translateX(2px);
  }

  /* Contact list */
  .footer-contact-list li {
    font-size: 0.95rem;
    line-height: 1.5;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    color: #E2DDD5;
  }

  .contact-label {
    font-size: 0.775rem;
    color: #94A3B8;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .footer-contact-list a {
    color: #FFFFFF;
    text-decoration: none !important;
    font-weight: 700;
    transition: color 0.15s ease;
  }

  .footer-contact-list a:hover {
    color: #F87171;
  }

  .footer-social-wrap {
    margin-top: 1.25rem;
  }

  .footer-social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #FFFFFF;
    text-decoration: none !important;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease;
  }

  .footer-social-btn:hover {
    background-color: rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
  }

  /* Bottom row */
  .footer-bottom {
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .copyright-text,
  .footer-subtext {
    font-size: 0.85rem;
    color: #94A3B8;
    margin: 0;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
      gap: 0.5rem;
    }
  }
</style>
